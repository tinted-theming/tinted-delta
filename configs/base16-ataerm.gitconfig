# vim: ft=gitconfig
# Scheme System: base16
# Scheme Name: Aftertaerm
# Scheme Author: Radek Polasek (https://github.com/radekp31), based on Taerminal by cozywigwam
# Template Author: Bez Hermoso

# Configures difftool "delta" to ue light or dark mode based on the variant declared by the colorscheme.
[delta]
    syntax-theme = "base16-256"
    light = false
