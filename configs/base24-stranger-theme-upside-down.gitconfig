# vim: ft=gitconfig
# Scheme System: base24
# Scheme Name: Stranger Theme Upside Down
# Scheme Author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
# Template Author: Bez Hermoso

# Configures difftool "delta" to ue light or dark mode based on the variant declared by the colorscheme.
[delta]
    syntax-theme = "base16-256"
    light = false
